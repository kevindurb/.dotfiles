ServerAliveInterval 5
ServerAliveCountMax 1
AddKeysToAgent yes

Host work
  HostName github.com
  IdentityFile ~/.ssh/work
  IdentitiesOnly yes

Host github.com
  HostName ssh.github.com
  Port 443

Host tablet steamdeck hoth corellia ender3
  User kevindurb

Host router travel-router
  User root

Host bastion-01
  User core

Host unimatrix-01 unimatrix-02 unimatrix-03 drone-01 drone-02 drone-03 drone-04
  User core

Host dev-pod
  User kevindurb
  Compression no
  IPQoS lowdelay
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h:%p
  ControlPersist 1h
  RequestTTY yes
  RemoteCommand tmux attach 2>/dev/null || tmux new
